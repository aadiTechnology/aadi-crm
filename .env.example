# Aadi CRM environment template.
# Placeholders only. Do not put real usernames, passwords, hostnames, database names,
# tokens, or certificate contents in this file.
#
# This repository does not load .env automatically. These lines do not change the
# running application until they are exported into the process environment.
# With CRM_DATABASE_URL unset or empty, SQLite remains the active database.

# CRM_DATABASE_PATH is the SQLite file. It is used when CRM_DATABASE_URL is unset
# or empty. The default file is backend/data/aadi_crm.sqlite.
CRM_DATABASE_PATH=backend/data/aadi_crm.sqlite

# CRM_DATABASE_URL selects PostgreSQL. USER, PASSWORD, HOST, and DATABASE below
# are placeholders, not credentials. This file is not loaded automatically, so
# these lines do not change the running application or copy any data.
#
# Put a real password in the process environment or a gitignored pgpass file.
# Do not commit a real URL. Remote PostgreSQL must use verify-full with a trusted
# CA and hostname checks. disable is accepted only when it is set explicitly and
# the host is loopback (localhost, 127.0.0.1, or ::1).
CRM_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
CRM_DATABASE_SSLMODE=verify-full

# Other settings the application already supports. The commented values are the
# loopback defaults in source, not secrets.
# PLATFORM_API_BASE_URL is read by backend/app/api/shell.py.
# CRM_REMINDER_EMAIL_MODE is read by backend/app/reminders_store.py (default: test).
# VITE_API_BASE_URL and VITE_CRM_API_BASE_URL are read by frontend/src/lib/config.ts.
# PLATFORM_API_BASE_URL=http://localhost:8000
# CRM_REMINDER_EMAIL_MODE=test
# VITE_API_BASE_URL=http://localhost:8000
# VITE_CRM_API_BASE_URL=http://localhost:8001
